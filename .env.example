# ============================================================================
# geo-aeo-tracker — environment template
# Copy this file to `.env` and fill in your own values:  cp .env.example .env
# Only the REQUIRED block is needed to run the tracker. Everything else is
# optional and the app degrades gracefully when it is missing.
# ============================================================================

# ----------------------------------------------------------------------------
# REQUIRED — Bright Data
# ----------------------------------------------------------------------------
# Your Bright Data API key (Account settings -> API keys).
BRIGHT_DATA_KEY=your_bright_data_api_key

# AI Scraper dataset IDs, one per engine. Get them from the Bright Data
# Scrapers Library: https://brightdata.com/cp/scrapers
# Each engine is independent — set only the ones you want to track. A missing
# dataset just skips that engine; it does not break the others.
BRIGHT_DATA_DATASET_CHATGPT=gd_xxx
BRIGHT_DATA_DATASET_PERPLEXITY=gd_xxx
BRIGHT_DATA_DATASET_COPILOT=gd_xxx
BRIGHT_DATA_DATASET_GEMINI=gd_xxx
BRIGHT_DATA_DATASET_GOOGLE_AI=gd_xxx

# OPTIONAL. Bright Data does not always list a public Grok scraper. If the
# Scrapers Library has no Grok dataset for your account, leave this blank and
# deselect Grok in the dashboard — the other engines run fine without it.
# BRIGHT_DATA_DATASET_GROK=gd_xxx

# ----------------------------------------------------------------------------
# REQUIRED — Bright Data zones for the SRO pipeline (SERP + Web Unlocker)
# Create these once in the Bright Data dashboard and paste the zone NAMES here.
# ----------------------------------------------------------------------------
# SERP API zone. Type: "SERP API". Default settings are fine.
# https://brightdata.com/products/serp-api
BRIGHT_DATA_SERP_ZONE=your_serp_zone

# Web Unlocker zone. Type: "Web Unlocker". Default settings are fine
# (JS rendering on, auto CAPTCHA). Used to scrape cited/target pages.
# https://brightdata.com/products/web-unlocker
BRIGHT_DATA_UNLOCKER_ZONE=your_web_unlocker_zone

# ----------------------------------------------------------------------------
# REQUIRED — OpenRouter (LLM inference for analysis, SRO, site-context)
# ----------------------------------------------------------------------------
OPENROUTER_KEY=your_openrouter_api_key

# OPTIONAL. Override the OpenRouter model. Default: google/gemini-3.5-flash
# OPENROUTER_MODEL=google/gemini-3.5-flash

# ----------------------------------------------------------------------------
# REQUIRED for SRO Analysis — Google Gemini API key
# This is SEPARATE from OpenRouter and does a different job. It powers the
# Gemini "grounding" stage, which uses Google Search grounding to see which
# pages Gemini actually cites in real time. OpenRouter cannot do that, so the
# key is needed even though OpenRouter is also configured. Without it, the rest
# of the SRO pipeline still runs and just skips the grounding stage.
# ----------------------------------------------------------------------------
GEMINI_API_KEY=your_gemini_api_key

# ----------------------------------------------------------------------------
# OPTIONAL — Supabase cloud sync (state is stored locally in the browser by
# default; set these only if you want cross-device sync).
# ----------------------------------------------------------------------------
# NEXT_PUBLIC_SUPABASE_URL=https://xxxx.supabase.co
# SUPABASE_URL=https://xxxx.supabase.co
# SUPABASE_SERVICE_ROLE_KEY=your_service_role_key
# NEXT_PUBLIC_CLOUD_STORAGE_ENABLED=true
# Shared secret gating cloud writes; enter the same value once in the UI.
# STATE_SYNC_SECRET=your_long_random_secret

# ----------------------------------------------------------------------------
# OPTIONAL — deploy a read-only preview with sample data and no API keys.
# ----------------------------------------------------------------------------
# NEXT_PUBLIC_DEMO_ONLY=true
